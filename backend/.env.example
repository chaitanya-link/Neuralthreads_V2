# Copy this file to .env and fill in real values. Never commit .env itself.

# From Neon: Project → Connection string → "Pooled connection", includes sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/neuraldb?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-generated-random-hex-string

# Comma-separated. Add your Vercel dashboard URL once deployed, plus
# "chrome-extension://<your-extension-id>" if you see CORS errors from the
# extension specifically (most extension contexts send no Origin header and
# are allowed through regardless — see server.js).
ALLOWED_ORIGINS=http://localhost:3000

PORT=5000